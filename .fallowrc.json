{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/routes/**/*.{ts,tsx}", "src/router.tsx", "src/start.ts"],
  "ignorePatterns": [".output/**", "src/routeTree.gen.ts"],
  "audit": {
    "gate": "new-only"
  },
  "ignoreCommandEntries": ["node"],
  "ignoreDependencies": ["@timey/local-issues"],
  "framework": [
    {
      "name": "factory-tooling",
      "entryPoints": ["scripts/*.mjs", "scripts/factory-ui/*-ui.js"],
      "entryPointRole": "support",
      "toolingDependencies": ["fallow", "yaml", "@timey/local-issues"],
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/**/*.mjs"
      }
    }
  ]
}

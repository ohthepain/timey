{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/routes/**/*.{ts,tsx}", "src/client.tsx", "src/ssr.tsx", "src/api.ts", "src/global-middleware.ts"],
  "ignorePatterns": [
    ".vinxi/**",
    ".output/**",
    "src/routeTree.gen.ts",
    "app.config.timestamp_*.js"
  ],
  "audit": {
    "gate": "new-only"
  },
  "ignoreCommandEntries": ["node"],
  "framework": [
    {
      "name": "factory-tooling",
      "entryPoints": ["scripts/*.mjs"],
      "entryPointRole": "support",
      "toolingDependencies": ["fallow", "yaml"],
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/**/*.mjs"
      }
    },
    {
      "name": "keycloak-theme",
      "entryPoints": [
        "keycloak-theme/login/resources/js/login.js",
        "keycloak-theme/login/resources/css/login.css"
      ],
      "entryPointRole": "support",
      "detection": {
        "type": "fileExists",
        "pattern": "keycloak-theme/login/resources/**"
      }
    }
  ]
}

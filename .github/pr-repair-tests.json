{
  "version": 1,
  "sourceRun": "Issue 203 approval latency repair",
  "tests": [
    {
      "name": "Approval admission, Git publication, and selected snapshot integrity",
      "command": [
        "node",
        "--test",
        "scripts/approval-refresh.check.mjs",
        "scripts/store-git-transaction.check.mjs",
        "scripts/store-git-github.check.mjs",
        "scripts/store-snapshot-files.check.mjs",
        "scripts/store-snapshot-scope.check.mjs"
      ]
    },
    {
      "name": "Atomic flow saves, native payloads, and delayed display races",
      "command": [
        "node",
        "--test",
        "scripts/project-stores-flow.check.mjs",
        "scripts/store-records.check.mjs",
        "scripts/store-atomic-flow.check.mjs",
        "scripts/flow-save-git.check.mjs",
        "scripts/store-runtime.check.mjs"
      ]
    },
    {
      "name": "Close imports the exact successful CI candidate and rejects invalid evidence",
      "command": ["node", "--test", "scripts/github-closure-proof.check.mjs"]
    },
    {
      "name": "Cleanup recovers after an unavailable retry without losing resource identity",
      "command": [
        "node",
        "--test",
        "--test-name-pattern=cleanup retains the selected identity",
        "scripts/factory-cleanup.check.mjs"
      ]
    },
    {
      "name": "Existing closure guards and cleanup actions remain enforced",
      "command": ["node", "--test", "scripts/flow-delivery.check.mjs", "scripts/factory-cleanup.check.mjs"]
    },
    {
      "name": "GitHub provider download transport and diagnostics",
      "command": [
        "node",
        "--test",
        "scripts/strategy-provider-diagnostics.check.mjs",
        "scripts/github-call-history.check.mjs"
      ]
    }
  ]
}

{
  "version": 1,
  "sourceRun": "https://github.com/ohthepain/timey/actions/runs/45310415306",
  "tests": [
    {
      "name": "Saved attempt transitions notify readers",
      "command": [
        "node",
        "--test",
        "--test-name-pattern=confirmed flow saves notify",
        "scripts/project-stores-flow.check.mjs"
      ]
    },
    {
      "name": "Paused playback notifies readers",
      "command": ["node", "--test", "--test-name-pattern=Flow notifies watchers", "scripts/flow.check.mjs"]
    },
    {
      "name": "Merge inherited-failure repair prompt and candidate verification",
      "command": [
        "node",
        "--test",
        "--test-name-pattern=Merge asks its worker to repair an inherited browser failure",
        "scripts/flow-executor.check.mjs"
      ]
    },
    {
      "name": "Store-backed proposal deletion, polling and attempt timers",
      "command": [
        "node",
        "scripts/flow-browser.mjs",
        "--stores",
        "--polling",
        "--timers",
        "--proposals",
        "--delayed-delete"
      ]
    }
  ]
}

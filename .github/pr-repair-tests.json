      "command": ["node", "--test", "--test-name-pattern=Flow notifies watchers", "scripts/flow.check.mjs"]
    },
    {
      "name": "Attempt timer labels update and survive reload",
      "command": ["node", "scripts/flow-browser.mjs", "--timers"]
    },
    {

# Domain database (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/timey_db?schema=domain"

# Auth database (Drizzle / Better Auth)
AUTH_DATABASE_URL="postgresql://postgres:password@localhost:5432/timey_db"

# Better Auth (server only — never VITE_)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-stable-secret-at-least-32-characters-long"

# Local password-reset mail (see AUTH_SETUP.md)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="noreply@themethod.local"
SMTP_SECURE="false"

# Database credentials (for docker-compose)
DB_USER="postgres"
DB_PASSWORD="password"

{
  "name": "tanstack-start-example-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "dev:debug": "node --inspect=0.0.0.0:9229 ./node_modules/vinxi/bin/cli.mjs dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-keycloak": "sh ./scripts/setup-keycloak-realm.sh",
    "export:realm": "sh ./scripts/export_realm.sh ./keycloak-theme/realm-export.json",
    "typecheck": "tsc --noEmit",
    "factory": "node scripts/factory.mjs",
    "test:factory": "node --test scripts/factory.check.mjs scripts/factory-interface.check.mjs scripts/factory-status.check.mjs scripts/verify.check.mjs scripts/audit-result.check.mjs scripts/factory-ui.check.mjs",
    "verify": "node scripts/verify.mjs",
    "audit:diff": "node scripts/verify.mjs --audit-only",
    "audit:staged": "node scripts/verify.mjs --staged --audit-only",
    "audit:step": "node scripts/verify.mjs --step --audit-only",
    "hooks:install": "node scripts/install-hooks.mjs",
    "auth:generate": "drizzle-kit generate --config auth/drizzle.config.ts",
    "auth:migrate": "drizzle-kit migrate --config auth/drizzle.config.ts",
    "test:auth": "python3 scripts/auth-fixture.py",
    "factory:ui": "node scripts/factory-ui.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-router": "1.114.29",
    "@tanstack/react-router-devtools": "1.114.29",
    "@tanstack/react-start": "1.114.29",
    "drizzle-orm": "1.0.0-rc.5",
    "immer": "10.1.1",
    "keycloak-js": "26.2.0",
    "pg": "8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "5.5.0",
    "redaxios": "0.5.1",
    "uuid": "11.1.0",
    "vexflow": "5.0.0",
    "vinxi": "0.5.3",
    "webmidi": "3.1.12",
    "zod": "4.6.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.14",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "3.1.2",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "1.0.0-rc.5",
    "fallow": "3.35.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prisma": "6.11.1",
    "smtp-server": "3.21.1",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.2",
    "yaml": "2.7.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "src/server/auth-runtime"
  ]
}

    "test:auth": "python3 scripts/auth-fixture.py",
    "factory:ui": "node scripts/factory-ui.mjs",
    "test:workflow": "node --test scripts/factory-workflow.check.mjs",
    "factory:deploy": "node scripts/factory-deploy.mjs",
    "test:chat": "node --test scripts/factory-chat.check.mjs scripts/factory-native-chat.check.mjs",
    "test:browser": "node scripts/factory-browser.mjs"
